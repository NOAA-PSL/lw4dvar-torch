exp:
  # model_backend selects which forecast model backs the 4D-Var solver:
  # 'aifs' (ECMWF AIFS-single-2.0, backends/aifs/), 'fcn3' (NVIDIA
  # FourCastNet3, backends/fcn3/), 'aurora' (Microsoft Aurora v1.5,
  # backends/aurora/), or 'ace2' (Ai2 ACE2-ERA5, backends/ace2/). Required --
  # load_config() raises if this is missing or not one of these values.
  # This one key also picks which conda env the job must run under (aifs2 /
  # fcstnet3 / aurora / ace2 -- see run_aifs.sh / run_fcn3.sh /
  # run_aurora.sh / run_ace2.sh); the envs are NOT
  # co-installed (see integrate_multiple_backends.md), so backends not selected here don't need
  # to be importable at all in the env you actually run with.
  model_backend: fcn3  # or: aifs, aurora, ace2, sfno

  # get_input() always builds the very first initial condition from an
  # ERA5 forecast `nhrs_back` hours before `sdate`, fetched via CDS -- see
  # backends/{aifs,fcn3,aurora}/*_ic.py.
  nhrs_back: 48 # initialize with a forecast this many hours before from sdate
  #restart: True # restart from a previous experiment
  restart: False
  rpath: './output/<previous_exp_name>/' # only read if restart: True -- the previous experiment's output dir

  # Each observation type gets its own block here, grouping that type's own
  # path/QC/error settings together -- mirrors the sibling JAX/NeuralGCM
  # solver's config.yml.template (greg-long-window-4dvar/long-window-4dvar's
  # `observations:` block, where every stream names its own `path:` with no
  # shared top-level fallback -- see integrate_prepbufr_obs.md "How the reference
  # repo does this"). Unlike that solver, this repo has no fixed-shape/
  # capacity-manifest machinery to canonicalize streams through (PyTorch
  # doesn't need JAX's retracing-safe padded arrays), so there is exactly
  # one implementation per type below, not a pluggable source/stream list.
  observations:
    # --- psobs (surface pressure) parquet reader settings ---
    psobs:
      # Root of the normalized, cycle-partitioned PREPBUFR parquet archive
      # (see psobs_parquet.py / integrate_prepbufr_obs.md) -- NOT the old
      # `psobs1_<YYYYMMDDHH>.txt`-file directory. Expects
      # `<path>/<YYYY-MM-DD>/<HH>/{reports,levels}/<CLASS>/part-00000.parquet`,
      # one six-hourly cycle directory per CLASS (e.g. ADPSFC, SFCSHP), as
      # produced by the `prepbufr_to_parquet` converter. Requires pyarrow in
      # the run's conda env (not installed in aifs1/aifs2/fcstnet3/aurora/
      # ace2 by default -- install it into whichever env you actually run
      # with). Required.
      path: './psobs_parquet'
      nobs_max: 15000  # fixed per-slot padding capacity (max obs kept per slot)
      #time_tolerance_hours: 3.0  # default dt_obs/2 -- max |report_time - slot_time| kept; also widened to resolve which 6h cycle directories are needed
      #prepbufr_classes: [ADPSFC, SFCSHP]  # PREPBUFR report classes to read
      # Report types kept, within the classes above. Default (180, 181, 187)
      # reproduces the legacy `.txt`-file psobs network (confirmed by counting
      # obtype codes in a full day of /scratch3/NCEPDEV/da/Jeffrey.Whitaker/psobs
      # files) -- the normalized archive also carries 183/281/282/284/287 for
      # the same two classes, which widens the network if included (see
      # prepbufr_to_parquet's prepbufr_parquet.md).
      #report_types: [180, 181, 187]
      #quality_mark_max: 3  # max accepted PREPBUFR quality mark (source QC)
      #use_source_error: False  # True: use each report's own pressure_error_mb instead of error_std_hpa
      #error_std_hpa: 1.0  # assigned ob error when use_source_error is False (or oberrstart <= 0)

    # --- raobs (radiosonde profile) settings -- omit this whole block (the
    # default) or leave `enabled: False` to assimilate surface pressure
    # only, unchanged. Only model_backend aifs/aurora are supported so far
    # (see RAOBS_SUPPORTED_BACKENDS) -- the 't'/'u'/'v'/'q' base-name forward
    # operator has only been exercised for those two. See integrate_prepbufr_obs.md.
    raobs:
      enabled: False
      # Which variables to assimilate -- any subset of these four; OMIT an
      # entry (e.g. drop specific_humidity) to turn just that one off without
      # disabling raobs entirely. Default (if enabled but this key is
      # omitted): all four, including specific_humidity -- humidity has no
      # reference-repo precedent (see integrate_prepbufr_obs.md) but is
      # implemented/QC'd (300 hPa floor) and was exercised together with
      # t/u/v in the full-pipeline smoke test; omit it explicitly below if
      # you want the old temperature+u+v-only default back.
      #variables: [temperature, u_component_of_wind, v_component_of_wind, specific_humidity]
      #path: same as observations.psobs.path by default -- the same parquet archive, ADPUPA class
      #prepbufr_classes: [ADPUPA]
      #time_tolerance_hours: 3.0  # default dt_obs/2, same convention as observations.psobs.time_tolerance_hours
      #quality_mark_max: 3
      # Mandatory-level matching tolerance (hPa): an obs level is kept only if
      # its reported pressure is within this of one of the MODEL's own pressure
      # levels (model.pressure_levels('t'/'u'/'v'/'q')) -- no vertical
      # interpolation. 0.05 hPa comfortably separates true mandatory-level
      # reports (recorded at exact round pressures) from significant levels.
      #pressure_match_tolerance_hpa: 0.05
      # Height-based QC (ported from the reference repo's bufr_radiosonde.py,
      # applied here per matched level): reject levels outside this physical
      # height range, or below the station's own elevation (by more than the
      # tolerance), or where height is non-monotonic with pressure.
      #height_min_m: -1000.
      #height_max_m: 60000.
      #below_station_tolerance_m: 100.
      # Observation-error standard deviations for temperature (K) and wind
      # components (m/s) -- NOT specific humidity, see below.
      #error_std: {t: 1.0, u: 2.0, v: 2.0}
      # Specific humidity error: a fixed per-level table (g/kg; ln(p)-
      # interpolated between entries, nearest beyond them). Default below:
      # Desroziers estimates from a ps + raobs run. Set null to use instead a
      # FRACTION of the observed value, floored (q_error_fraction /
      # q_error_floor_kg_kg) -- the old default, which weights dry obs most and
      # pulls the analysis dry.
      #q_error_g_kg: {1000: 1.4, 925: 1.0, 850: 1.05, 700: 0.95, 600: 0.8, 500: 0.6, 400: 0.33, 300: 0.13}
      #q_error_fraction: 0.2
      #q_error_floor_kg_kg: 1.e-5
      # Background check on q: reject |O-B| > q_bg_check * error, at the
      # current state (default 4.0; null turns it off).
      #q_bg_check: 4.0
      # Radiosonde humidity sensors are unreliable above the lower/mid
      # troposphere -- mask 'q' at any matched level with pressure below this
      # (set null to disable the floor entirely).
      #humidity_min_pressure_hpa: 300.
      # Fixed per-slot station capacity (padding size) -- by default (this key
      # omitted) sized to the largest slot actually read; set an explicit
      # integer only if you need a stable shape across configs/runs.
      #station_capacity: 1000

    # --- amv (satellite-derived wind) settings -- omit this whole block (the
    # default) or leave `enabled: False` to assimilate without it, unchanged.
    # Reads the SAME normalized PREPBUFR parquet archive's 'SATWND' class
    # (GOES/JMA/EUMETSAT/MODIS cloud-drift and water-vapor winds, already
    # merged/QC'd into the operational PREPBUFR feed) -- NOT the separate
    # raw-BUFR GOES-16 `amv_parquet` archive (a future, NOT-yet-integrated
    # stream; see integrate_amv_satwnd.md for why and what adding it would
    # take). Only model_backend aifs/aurora are supported so far (see
    # AMV_SUPPORTED_BACKENDS) -- the 'u'/'v' base-name forward operator has
    # only been exercised for those two.
    #
    # Raw SATWND wind vectors are heavily spatially/vertically correlated
    # (adjacent satellite pixels) -- they are ALWAYS thinned (GSI-style
    # horizontal x vertical mesh box, keeping exactly ONE observation per
    # box -- ported from GSI's own `read_satwnd.f90`/`setupw.f90`, see
    # integrate_amv_satwnd.md "GSI comparison" for why composite-stencil
    # superobbing was replaced with this) before entering the loss; there
    # is no "assimilate raw" option.
    amv:
      enabled: False
      #path: same as observations.psobs.path by default -- the same parquet archive, SATWND class
      #prepbufr_classes: [SATWND]
      #time_tolerance_hours: 1.0  # tighter than psobs/raobs's default -- satellite reports are time-tagged precisely
      #report_types: null  # null = every SATWND report type; set a list to restrict the network
      #quality_mark_max: 3
      # Pressure range (hPa) of winds to read, intersected with the model's
      # own pressure-level range at run time (so this rarely needs changing).
      #pressure_range_hpa: [1000., 50.]
      #use_source_error: True  # True: use each report's own wind_error_ms instead of fallback_error_std_ms
      #fallback_error_std_ms: 7.0
      # Satellite ids to EXCLUDE from this SATWND stream -- for later use
      # once a second, raw GOES-16 `amv_parquet` stream is added alongside
      # this one, to avoid double-counting the same real observations (see
      # integrate_amv_satwnd.md). Empty by default; harmless to leave empty
      # with no second stream configured.
      #exclude_satellite_ids: []
      # Thinning-box grouping keys, in addition to the horizontal/vertical
      # mesh cell -- both default True, so distinct report types/satellites
      # never compete for the same box even if co-located.
      #separate_report_types: True
      #separate_satellite_ids: True
      # GSI-style thinning mesh (ported from `read_satwnd.f90`'s own
      # `rmesh`/`pmesh`, INDEPENDENT of the model's native grid resolution):
      # at most one observation is kept per (rmesh_km horizontal x
      # pmesh_hpa vertical [x report_type] [x satellite_id]) box -- the one
      # with the lowest GSI-style "badness" score (closest to the
      # verification time, tie-broken by assigned error -- GSI itself also
      # uses the AMV producer's own quality-indicator/expected-error
      # fields here, which this repo's parquet archive doesn't carry).
      # 120 km matches the conventional-data example in the GSI User's
      # Guide (ithin/rmesh/pmesh, section 3.4.7); 50 hPa is a reasonable
      # starting point, not a confirmed operational SATWND value -- tune
      # both against your model's native grid/level spacing.
      #rmesh_km: 120.0
      #pmesh_hpa: 50.0
      # vertical_bin_mode: 'pmesh' (default, above) or 'nearest_level' --
      # bins by the model's own nearest pressure level instead of a
      # fixed-width pmesh_hpa mesh. On a model with few real vertical
      # degrees of freedom (e.g. ACE2's 8 native layers vs. a uniform
      # pmesh_hpa mesh which doesn't know that), 'nearest_level' both caps
      # the vertical bin count at the model's own level count and
      # guarantees the kept observation is closer to its assigned level
      # than to any other, by construction -- pmesh_hpa is unused in this
      # mode. See integrate_amv_satwnd.md "Vertical thinning tied to model
      # levels".
      #vertical_bin_mode: pmesh
      # Floor on the per-observation assigned error (source or fallback).
      #error_floor_ms: 4.0
      # Background gross check (GSI's `setupw.f90`): reject an observation
      # whose |O-B| exceeds background_check_stddev * clip(error,
      # error_min_ms, error_max_ms), evaluated at the CURRENT state every
      # loss call. error_min_ms/error_max_ms default to no clamping (plain
      # |O-B|/error, same convention as raobs_q_bg_check/
      # gpsro_background_check_stddev) -- set both to adopt GSI's full
      # clamped-ratio form. Set background_check_stddev: 0 (or null) to
      # disable the gross check entirely.
      #background_check_stddev: 4.0
      #error_min_ms: null
      #error_max_ms: null
      # Fixed per-slot capacity (padding size) -- by default (this key
      # omitted) sized to the largest slot actually read. Thinning keeps
      # far fewer observations than the old superobbing design, so this
      # can be much smaller than before.
      #capacity: 100000

    # --- aircraft (AIRCAR/AIRCFT temperature + wind) settings -- omit this
    # whole block (the default) or leave `enabled: False` to assimilate
    # without it, unchanged. Reads the SAME normalized PREPBUFR parquet
    # archive's 'AIRCAR'/'AIRCFT' classes. Only model_backend aifs/aurora/
    # ace2 are supported so far (see AIRCRAFT_SUPPORTED_BACKENDS) -- the
    # 't'/'u'/'v' base-name forward operator reuses the same decode path
    # already exercised for raobs/amv on those three. See
    # integrate_aircraft_obs.md.
    #
    # Structurally identical to amv (vectorized read, native-pressure point
    # stencil, GSI-style box thinning -- always thinned, no "assimilate
    # raw" option) EXCEPT temperature and wind are thinned as TWO
    # INDEPENDENT sub-streams: the archive reports AIRCAR/AIRCFT
    # temperature and wind as mutually exclusive rows (report_type 133 =
    # temperature-only mass report, 233 = wind-only report, for the SAME
    # physical observation -- confirmed directly, zero rows carry both), so
    # a single shared thinning box keyed across all three variables would
    # otherwise silently keep only a temperature OR a wind row per box.
    # GSI's own convinfo treats these as separate thinning types for
    # exactly this reason.
    aircraft:
      enabled: False
      #path: same as observations.psobs.path by default -- the same parquet archive, AIRCAR/AIRCFT classes
      #prepbufr_classes: [AIRCAR, AIRCFT]
      #time_tolerance_hours: 1.0  # tighter than psobs/raobs's default, same as amv -- high-rate reports are time-tagged precisely
      #report_types: null  # null = every AIRCAR/AIRCFT report type; set a list to restrict the network
      #quality_mark_max: 3
      # Pressure range (hPa) read, intersected with the model's own
      # pressure-level range at run time (so this rarely needs changing).
      #pressure_range_hpa: [1000., 50.]
      #use_source_error: True  # True: use each report's own temperature_error_c/wind_error_ms instead of the fallback_error_std_* below
      #fallback_error_std_t_k: 1.5
      #fallback_error_std_ms: 3.5
      # Thinning-box grouping key, in addition to the horizontal/vertical
      # mesh cell -- default True, same convention as amv's
      # separate_report_types (no separate_satellite_ids analogue here --
      # aircraft has no satellite identity).
      #separate_report_types: True
      # GSI-style thinning mesh (same scheme/defaults as amv -- see amv's
      # comment above), applied IDENTICALLY to both the temperature and
      # wind sub-streams (one thinning policy, not two).
      #rmesh_km: 120.0
      #pmesh_hpa: 50.0
      #vertical_bin_mode: pmesh  # or: nearest_level -- see amv's comment above
      # Floor on the per-observation assigned error (source or fallback),
      # per sub-stream (different units).
      #error_floor_t_k: 0.5
      #error_floor_ms: 2.0
      # Background gross check (same ported GSI form as amv/raobs/gpsro),
      # evaluated at the CURRENT state every loss call, applied identically
      # to both sub-streams; error_min/max clamp bounds are per-sub-stream
      # (temperature K vs wind m/s). Set background_check_stddev: 0 (or
      # null) to disable the gross check entirely.
      #background_check_stddev: 4.0
      #error_min_t_k: null
      #error_max_t_k: null
      #error_min_ms: null
      #error_max_ms: null
      # Fixed per-slot capacity (padding size), shared by both sub-streams
      # -- by default (this key omitted) each sub-stream is independently
      # sized to its own largest slot actually read.
      #capacity: 100000
      # Static pressure x region temperature bias correction (default
      # False -- opt in). NOT per-tail: per-tail would need either this
      # repo's own ACE2 cycling to estimate online (which has its own
      # known issues, so this deliberately doesn't use it) or an external
      # GSI run's tail numbers, which share zero overlap with this
      # archive's own tail IDs (checked directly -- every PREPBUFR
      # extraction appears to independently anonymize tail numbers, not
      # just a fleet-turnover effect). Instead this subtracts a static
      # (pressure bin, NH/Tropics/SH region) mean O-B looked up from
      # `bias_correction_table`, built once from a real, independent GSI
      # operational archive -- see build_aircraft_temperature_bias_table.py
      # and integrate_aircraft_obs.md. Wind is not corrected (same scope
      # as GSI's own aircraft_t_bc; a real-data check found no systematic
      # per-tail wind bias to correct, unlike temperature).
      #bias_correction_enabled: False
      #bias_correction_table: aircraft_temperature_bias_table.json  # repo-root-relative default

    # --- gpsro (GPS radio-occultation bending angle) settings -- omit this
    # whole block (the default) or leave `enabled: False` to assimilate
    # without it, unchanged. Reads a DIFFERENT, Hive-partitioned archive
    # (`<path>/year=YYYY/month=MM/day=DD/*.parquet`, one flat
    # candidate-bending-angle-table file per cycle) -- NOT the PREPBUFR
    # archive psobs/raobs/amv share, so `path` is required with no
    # fallback. Only model_backend aifs/aurora are supported so far (see
    # GPSRO_SUPPORTED_BACKENDS) -- the 't'/'q'/'z' forward operator (a
    # differentiable 1D Abel-transform bending-angle simulator, ported and
    # cross-validated against the `long-window-4dvar` reference repo's
    # JAX implementation) has only been exercised for those two. See
    # integrate_gpsro.md.
    gpsro:
      enabled: False
      path: '/path/to/gpsro_parquet'
      #time_tolerance_hours: 1.5
      # Impact-height window (km) read -- intersected with whatever the
      # forward operator can actually support: the model's own vertical
      # extent PLUS top_extrapolation_km below (AIFS-single-2.0's top is
      # ~31 km; the default 40 km upper bound here is covered by the
      # default 10 km extrapolation -- see integrate_gpsro.md).
      #impact_height_range_km: [6., 40.]
      # Vertical thinning: keep at most one level per this spacing (m),
      # walking bottom-to-top. GSI itself does NOT thin GPSRO (confirmed
      # directly against read_gps.f90/setupbend.f90) -- but GSI's own
      # forecast models carry 60-150+ vertical levels, so an unthinned
      # profile still has real degrees of freedom to fit against. This
      # repo's 14-level model backends (AIFS-single-2.0: top 10 hPa) do
      # not: removing this thinning (tried 2026-10-20) inflated gpsro's
      # effective weight in the loss by ~(levels-per-profile / 14),
      # confirmed in a real run (gpsro's Jo grew ~6-7x and dominated the
      # total loss over raobs/amv) -- see integrate_gpsro.md "GSI
      # comparison". Kept at the original 1000 m default.
      #impact_height_spacing_m: 1000.
      #maximum_bending_angle_rad: 0.1  # read-time sanity bound
      #quality_flags_disqualifying_mask: 0  # nonzero: reject levels whose source QFRO bits intersect this mask
      #minimum_percent_confidence: null  # null: no producer-confidence floor
      # Observation-error model -- 'ecmwf_seed_v1' (the only one
      # implemented so far) is a simple fractional-plus-floor analytic
      # placeholder, NOT a reviewed/Desroziers-diagnosed profile (unlike
      # raobs's q_error_g_kg table -- see integrate_gpsro.md for why this
      # starts simpler).
      #error_model: {name: ecmwf_seed_v1, fractional_at_0_km: 0.20, fractional_at_10_km: 0.01, absolute_floor_rad: 3.e-6}
      # Simulated-bending-angle sanity bound and background check,
      # evaluated at the CURRENT state every loss call (same convention as
      # raobs's q_bg_check -- simpler than GSI's frozen,
      # once-before-optimization version; see integrate_gpsro.md). null
      # turns the background check off.
      #maximum_simulated_bending_angle_rad: 0.05
      #background_check_stddev: 4.0
      # GSI-style clamped-ratio gross check (setupbend.f90): ratio =
      # |O-B| / clip(error, error_min_rad, error_max_rad) >
      # background_check_stddev. Both null (default) means no clamping --
      # plain |O-B|/error, this repo's prior convention. Set both to adopt
      # GSI's full clamped-ratio form.
      #error_min_rad: null
      #error_max_rad: null
      # Model-top extension (ported from GSI's setupbend.f90, which
      # extends its own discrete grid the equivalent way, via nsig_ext):
      # trust the top model layer's own exponential-decay scale height up
      # to this many km ABOVE the model's native top refractional height,
      # instead of rejecting any tangent point above it outright. No
      # operator-math change needed -- exponential_top_bending_angle
      # already extrapolates correctly that far; this only widens how far
      # the validity mask is willing to trust it. Default 10 km reclaims
      # AIFS-single-2.0's ~31-40 km band (previously ~0% used, confirmed
      # in a real run's diagnostics) that impact_height_range_km's default
      # upper bound already reads but the old validity check discarded.
      #top_extrapolation_km: 10.0
      # Super-refraction (SR) screen, a simplified port of GSI's
      # setupbend.f90 SR check (reject-only, no ray relocation above a
      # detected SR layer -- see integrate_gpsro.md "GSI comparison"):
      # reject a ray below sr_screen_height_km whose column has, at or
      # below its own impact height, a layer with |refractivity gradient|
      # >= sr_detection_fraction * critical_gradient_n_per_km. Defaults
      # are GSI's own values (157 N-units/km is the literature critical
      # gradient at which a ray becomes trapped/ducted). Set
      # critical_gradient_n_per_km to null/0 to disable this check.
      #critical_gradient_n_per_km: 157.0
      #sr_detection_fraction: 0.75
      #sr_screen_height_km: 5.0
      # Fixed per-slot (profile, level) capacities -- by default (both keys
      # omitted) sized to the largest slot actually read.
      #profile_capacity: 1000
      #level_capacity: 60

  ic_suffix: '96h_100it' # pkl file info for restart
  sdate: '2015-01-01T00' # experiment start date; if restart, use date in pkl filename
  n_init: 24 # number of DA cycles
  dt_init: 12 # assimilation cycling interval in hours (must be a multiple of the model's fixed 6h step)
  # for longer forecast (if not present, long forecast not run)
# dt_forecast: 24 # long forecast output interval in hours
# n_forecast: 10 # long forecast length in steps of length dt_forecast
# save initial and final trajectory output on these isobaric levels (set to "all" for all levels)
  #save_levs = 'all'
  save_levs: [1000, 850, 500, 250, 50]
  cycle: True # cycling data assimilation -- REQUIRED (True) when n_init > 1;
  # load_config raises for n_init > 1 with cycle: False (it used to silently
  # skip advancing the analysis to the next cycle time, see
  # integrate_multiple_backends.md "cycle: False with n_init > 1")
  exp_name: 'test_v1' # data is saved in this subdirectory

  # --- path_model / model_backend-specific checkpoint keys ---
  # AIFS: path_model is the DIRECTORY containing the checkpoint; the
  # checkpoint's own filename is given separately via model_name.
  #   path_model: './backends/aifs/aifs-single-2.0/'
  #   model_name: 'aifs-single-mse-2.0.ckpt'
  #   aifs_config: 'backends/aifs/aifs_inference.yaml' # static anemoi-inference config (pre/post-processors, typed_variables)
  # FCN3: path_model IS the vendored HF checkpoint clone directory itself
  # (config.json, checkpoint, orography.nc, land_mask.nc, ...) -- no
  # separate model_name key.
  #   path_model: './backends/fcn3/fourcastnet3/'
  # Aurora: path_model is the Hugging Face cache snapshot directory
  # aurora_prefetch_checkpoint.py fetches into (NOT a git submodule, unlike
  # AIFS/FCN3 -- microsoft/aurora on HF is a shared monorepo of many
  # unrelated checkpoints; see integrate_multiple_backends.md) -- no separate model_name key,
  # the checkpoint/static-pickle filenames inside it are fixed.
  #   path_model: './backends/aurora/hf_cache/models--microsoft--aurora/snapshots/a96afd7ee6d65e3bd2d476f3be798a25a56f2296/'
  # ACE2: path_model is the backends/ace2/ACE2-ERA5 git submodule
  # (huggingface.co/allenai/ACE2-ERA5, used POINTER-ONLY: init it with
  # GIT_LFS_SKIP_SMUDGE=1, then backends/ace2/ace2_prefetch_checkpoint.py
  # pulls just the checkpoint + forcing_data/forcing_YYYY.nc for every year
  # a run touches -- the full repo is ~75 GB). model_name defaults to 'ace2_era5_ckpt.tar'; forcing_dir
  # defaults to path_model + 'forcing_data/'. ic_cache must hold the ICs and
  # h500/TMP850 verification from backends/ace2/ace2_ic.py (ace2ic env,
  # login node: `ace2_ic.py DATE` and `ace2_ic.py --verif DATE ...`).
  # ps_operator defaults to 'ps_native'; reset_skt_ocean is rejected.
  #   path_model: './backends/ace2/ACE2-ERA5/'
  #   ic_cache: './ic_cache_ace2/'
  # SFNO (NVIDIA SFNO-73ch-small from NGC, run with makani in the fcstnet3
  # env): path_model is the converted package dir fetched by
  # backends/sfno/sfno_prefetch_checkpoint.py (not a submodule -- NGC isn't
  # git). ic_cache can be FCN3's ERA5 cache: SFNO's 73 channels are FCN3's 72
  # plus 'sp', which backends/sfno/sfno_ic.py adds as one small file per date.
  # sfno_latent_block (default -2): the SFNO block whose output receives the
  # latent increment -- -2 = block 6, the last 240x480 latent (384x240x480);
  # -1 = block 7's full-resolution output (384x721x1440, 9x larger).
  # ps_operator: both 'logpinterp' (default, better O-B fit) and 'ps' work.
  # checkpoint_stride must stay 1 for a 5-day window (2 and 4 run out of
  # memory even in bf16: each unsaved 0.25 deg step holds ~18 GiB).
  #   path_model: './backends/sfno/ngc_cache/sfno_73ch_small/'
  #   ic_cache: '/scratch4/BMC/gsienkf/Jeffrey.Whitaker/long-window-4dvar-fcstnetv3/ic_cache/'
  path_model: './backends/fcn3/fourcastnet3/'

  device: 'cuda'
  path_output: './output/' # where to write output named by subdirectory exp_name
  # ERA5 initial-condition/verification fetches (backends/{aifs,fcn3}/*_ic.py)
  # are cached here. The fetch itself needs internet (CDS) -- warm this
  # cache from a login node before submitting the (offline) H100 job (see
  # fcn3_prefetch_ic.py / aifs_prefetch_ic.py in the source repos).
  ic_cache: './ic_cache/'
  print_every: 10
  # optionally increase ob error linearly through window to give more weight to
  # loss at beginning of window (crude treatment of model error).
  oberrstart: 1.0 # ob error at start of window (-1 to use surface_pressure_error_std_hpa / per-report source error instead)
  oberrdeltaperday: 0.25 # ob error increase (per day) within window.
  # qc_fixed_oberr: gross check (bg_check) uses the START-of-window ob error
  # instead of the grown one, so down-weighting late-window obs via
  # oberrdeltaperday doesn't also loosen their QC. Default False (earlier
  # runs' behavior: QC uses the grown error).
  #qc_fixed_oberr: True
  # jc_ps_weight (kappa, hPa^-2): optional balance penalty (a Jc term) on how
  # fast the pressure increment changes over the first step after injection
  # (t+6h -> t+12h):
  #   Jc = kappa * N_obs * area-weighted grid mean of Delta^2,
  #   Delta = analysis pressure tendency minus background pressure tendency
  #   over that step (hPa), N_obs = ps obs available in the window.
  # Pressure field: surface pressure where the backend has it (ACE2, AIFS,
  # Aurora), else mean sea-level pressure (FCN3) -- chosen automatically,
  # named in the log. The grid mean makes kappa independent of model
  # resolution; the N_obs factor keeps Jc / Jo roughly fixed as observation
  # counts change. Damps the transient, unbalanced mass-field part of the
  # increment (ACE2: ps increment ~0.5 hPa rms at 6h in the NH, decaying ~5x
  # within 24h).
  # Reference (ACE2, 5-day window, ~2.1e5 obs): kappa ~ 30 is a strong
  # constraint (first-step change cut >100x; tested in a month of cycling);
  # kappa ~ 3 / ~0.3 are moderate / light. The log line also prints the
  # equivalent per-point sigma, (n_points / (kappa * N_obs)) ** 0.5. Off
  # unless set. (Replaces the removed jc_ps_sigma: sigma = s corresponds to
  # kappa = n_points / (s^2 * N_obs).)
  #jc_ps_weight: 30.

  # The 4D-Var control variable is a one-time latent-space increment
  # injected at the first rollout step -- NOT a physical-space
  # perturbation. Its shape/meaning is backend-specific:
  #   AIFS: AIFSModel.latent_shape -- 40320 O96 hidden-mesh nodes x 1024
  #     channels (an earlier physical-space path with per-variable
  #     `state_scales` preconditioning was retired once latent control was
  #     confirmed to out-converge it with no per-variable tuning needed).
  #   FCN3: FCN3Model.latent_shape -- (641, 360, 720): 13 atmospheric
  #     pressure-level groups x 45 channels + 56 surface channels, on the
  #     downsampled 360x720 hidden grid.
  # Either way, because the decoder produces the NEXT state as a fresh
  # function of the (perturbed) latent rather than reconstructing the
  # current one, the analysis this produces is only ever valid at
  # `window_start + dt_verif`, never `window_start` itself --
  # compute_optimal returns a state carrying that date, and downstream code
  # (the cycling loop, save_trajectory_diagnostics, printz500err) is built
  # around it. Judge convergence quality from the run's loss-history JSON
  # (`*_loss_latent_*.json`).
  #latent_scale: 1.0 # optional global preconditioner divided into the
  #   latent increment inside the differentiable forward pass (rarely
  #   needed -- tune learn_rate first)

  # control_variables: decode-time mask (list of model variable/family base
  # names) -- at the injection step, packed-state columns NOT named here
  # are overwritten with the uncorrected first-step forecast, zeroing the
  # increment's *direct* effect on them (they can still respond indirectly,
  # through model dynamics, to columns that ARE controlled). Omit for
  # unrestricted (every column controllable), the default. Vocabulary is
  # backend-specific (validated against model.resolve_columns at run time):
  #   AIFS example (don't update wave variables or volumetric soil moisture):
  #     control_variables: [u, v, t, z, q, sp, msl, 2t, 2d, 10u, 10v, tcw, skt, sot]
  #   FCN3 example (no sp/skt/sot -- FCN3 has none of these):
  #     control_variables: [u, v, t, z, q]
  #   Aurora example (has native sp AND skt/lsm, unlike FCN3):
  #     control_variables: [u, v, t, z, q, sp, msl, 2t, 2d, 10u, 10v, tcwv, skt]
  # control_variables: [u, v, t, z, q]

  # loss_variables: which decode_state fields are (time-interpolated, for
  # dt_obs < dt_verif, and) fed to the ps forward operator. Defaults to
  # exactly what the active ps_operator reads:
  #   'logpinterp' (all three backends, FCN3/Aurora's only supported option): z
  #   'ps' (AIFS only -- see ps_operator below): t, q, sp
  #   'ps_native' (ACE2 only): t_lowest, q_lowest, p_lowest, sp
  # There is no reason to override this for FCN3/Aurora. Only set this
  # explicitly for AIFS if you know you need to.
  # loss_variables: [z]

  # ps_operator: forward operator for the surface-pressure observations.
  #   'logpinterp' (default, all three backends): pressure-level geopotential
  #     search -- needs only 'z', which all three backends have at every level.
  #   'ps' (AIFS ONLY): native surface-pressure + t700/q700 station-pressure
  #     reduction. NOT supported for FCN3 (no native 'sp' decode_state field
  #     at all) -- load_config() raises if model_backend=='fcn3' and this is
  #     set to 'ps'. Also blocked for Aurora for now -- Aurora DOES have a
  #     native 'sp' field, so this may work in principle, but that forward-
  #     operator path has only been tested for AIFS so far; load_config()
  #     raises rather than silently claim untested support.
  #   'ps_native' (ACE2 ONLY): native surface pressure reduced to station
  #     height using the LOWEST NATIVE MODEL LEVEL's t/q and that level's
  #     own pressure (ACE2's layers are hybrid sigma-pressure -- no
  #     interpolation to 700 hPa). load_config() raises for other backends.
  #ps_operator: 'ps'

  # reset_skt_ocean: AIFS and Aurora only (False/unset default). True
  # resets `skt` (skin temperature) at ocean grid points (lsm <
  # skt_ocean_lsm_threshold) to fresh ERA5 truth at every new analysis time
  # (every DA cycle -- NOT every window within one cycle), instead of
  # letting the model's own carried-forward/predicted skt persist there
  # across cycles. Neither checkpoint has a separate SST or sea-ice
  # variable -- skt is the only surface-temperature-like prognostic field
  # for either, and ECMWF's own operational/ERA5 skt is already defined as
  # the SST analysis over open ocean (blended via the land-sea mask
  # upstream of this whole pipeline). NOT supported for FCN3 -- FCN3 has no
  # 'skt'/'lsm' decode_state field to reset at all; load_config() raises if
  # model_backend=='fcn3' and this is set to True, rather than silently
  # ignoring it. Aurora's 'lsm' is given its own packed-state column
  # specifically to support this (see aurora_model.py) -- not yet
  # exercised by a real run, only by construction/unit-level checks.
  #reset_skt_ocean: True
  #skt_ocean_lsm_threshold: 0.5 # lsm is a land fraction in [0, 1]; grid
  #   points below this are treated as "ocean" for the reset

  # atmo_chunk_size: FCN3 ONLY (default 2, meaningless for AIFS/Aurora). How
  # many of FCN3's 13 atmospheric pressure-level groups are pushed through
  # the encoder/decoder in one call at a time, instead of all 13 at once --
  # see the original long-window-4dvar-fcstnetv3 repo's CLAUDE.md "decode()
  # memory investigation and fix" section. 2 is the value that sweep found
  # best (lowest memory, no measurable speed cost); only change this if
  # re-profiling for a different rollout length/GPU.
  #atmo_chunk_size: 2

  # compile_wrapper: Aurora ONLY (default False, meaningless for AIFS/FCN3).
  # Wraps the Aurora model in torch.compile() -- a real, confirmed ~1.87x
  # steady-state speedup (see integrate_multiple_backends.md "Aurora per-epoch runtime
  # optimization"), correctness-verified, but at a real one-time
  # compilation cost (130-270s, not fixed, paid separately for each
  # distinct (steps, use_checkpoint) combination the run actually
  # exercises -- the main loop, ref_state1, diagnostics, and forecasts
  # calls all differ). Worth enabling for a run with enough epochs at the
  # same window length for the speedup to amortize past that tax (a
  # 100-epoch run comfortably clears this; a 3-5 epoch smoke test likely
  # does not) -- default is off since the cost/benefit depends on epoch
  # count, not something safe to assume for every run.
  #compile_wrapper: True
  # autocast_dtype: mixed precision for the model rollout, one key for every
  # backend that supports it ('bfloat16'/'bf16', 'float16'/'fp16',
  # 'float32'/'fp32'); load_config raises for a backend that doesn't:
  #   aifs:   bfloat16 | float16      (default bfloat16; the checkpoint's own
  #           fp16 overflowed in backward for aifs-single-1.1)
  #   aurora: bfloat16 | float16      (default bfloat16; fp16 diverged)
  #   sfno:   bfloat16 | float32      (default float32; bfloat16 autocasts only
  #           the 8 SFNO blocks -- encoder/decoder stay fp32 so bf16 rounding
  #           never lands on surface pressure: -14% time / -21% memory for a
  #           20-step window, gradient cos 0.9997 vs fp32)
  #   ace2, fcn3: not supported (fp32).
  # 'aifs_autocast_dtype' is a deprecated alias for this key.
  #autocast_dtype: 'bfloat16'

  # grid_interp: FCN3 and Aurora only (default 'bilinear', meaningless for
  # AIFS -- AIFS's irregular N320 octahedral grid always uses the k-d-tree
  # approach, no config key needed). How ps-obs are interpolated to/from
  # the model's regular 0.25deg grid. 'bilinear' (BilinearGridInterpolator,
  # backends/fcn3/fcn3_grid.py -- Aurora reuses this directly, see
  # get_grid_interpolator) is exact and ~50x faster per obs slot than
  # 'kdtree' (GridInterpolator, the k=4 inverse-distance-weighted k-NN
  # approach AIFS always uses) -- see the original repo's
  # verify_bilinear_grid_interp.py. 'kdtree' is kept only as an A/B
  # fallback; there is no reason to set this for either backend's regular
  # grid.
  #grid_interp: bilinear

  # checkpoint_stride (default 1, i.e. every step; shared key, both
  # backends): only every `checkpoint_stride`-th step is wrapped in
  # torch.utils.checkpoint (trading memory for speed -- a non-checkpointed
  # step keeps its activations for backward instead of recomputing them).
  # Set to 0 to disable checkpointing entirely for a memory-rich GPU/short
  # window; validate with the usual "does AdamW still monotonically reduce
  # the loss" check before trusting a non-default value on a new window
  # length. Validated for AIFS across several window lengths; untested for
  # FCN3 so far.
  #checkpoint_stride: 0

windows:
  '4': # window name (days)
    n_verif: 16 # window length in units of dt_verif (96h window)
    dt_verif: 6 # spacing between verification times, in hours -- must be a multiple of the model's fixed 6h step
    #dt_obs: 6 # ps observation sampling interval in hours (default dt_verif;
    #   must divide both dt_verif and the model's fixed 6h step). Finer
    #   than 6h obs are matched to a linearly time-interpolated model state
    #   between the bracketing 6h steps -- validated for AIFS (a known
    #   unmitigated tidal (S2) representativeness error at off-step slots
    #   is documented there); untested for FCN3.
    # learn_rate is NOT shared across backends -- each was tuned
    # independently and a shared default would silently mistune one of
    # them:
    #   AIFS:  learn_rate: 2.0e-3
    #   FCN3:  learn_rate: 1.0e-2  (single-step converged at 0.01, 0.05
    #          diverged for a 2-step rollout -- NOT yet tuned for a real
    #          multi-day window, retune before trusting this)
    learn_rate: 1.0e-2
    weight_decay: 1.0e-3 # weight decay regularization
    max_epoch: 100 # number of epochs
    warmup_steps: 10 # epochs for linear warmup
    start_factor: 0.1 # start factor for learning rate at beginning of warmup
    end_factor: 0.1 # end factor for learning rate at end of cosine decay
    beta1: 0.9 # beta factors for adamw
    beta2: 0.999
    bg_check: 4. # background check
    zthresh: 500. # orog diff threshold
    zconst: 0.003 # factor to boost ob error
    suffix: ''
